          "value": "function() {\n  var host = window.location.hostname;\n  var dominios = __DOMAINS__;\n\n  for (var i = 0; i < dominios.length; i++) {\n    if (host === dominios[i] || host.indexOf('.' + dominios[i], host.length - dominios[i].length - 1) !== -1) {\n      return '.' + dominios[i];\n    }\n  }\n\n  return 'auto';\n}"
