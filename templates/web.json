    {
      "variableId": "26",
      "name": "05.02 👦🏼 JS sobrenome - Adaptada",
      "type": "jsm",
      "parameter": [
        {
          "type": "TEMPLATE",
          "key": "javascript",
          "value": "function() {\n  var selectors = [\"#iogui-nome\", \"#form-field-name\", \"input[name=\\\"nome\\\"]\", \"input[name=\\\"name\\\"]\", \"input[id*=\\\"nome\\\"]\", \"input[id*=\\\"name\\\"]\"];\n  var raw = null;\n  var veioDoCookie = false;\n\n  for (var i = 0; i < selectors.length; i++) {\n    var el = document.querySelector(selectors[i]);\n    if (el && el.value && el.value.trim()) { raw = el.value.trim(); break; }\n  }\n\n  if (!raw) {\n    var match = document.cookie.match(/(?:^|;\\s*)ck_ln=([^;]+)/);\n    if (match) { raw = decodeURIComponent(match[1]).trim(); veioDoCookie = true; }\n  }\n\n  if (!raw) return null;\n\n  function capitalizar(texto) {\n    return texto.split(/\\s+/).map(function(p) {\n      return p.charAt(0).toUpperCase() + p.slice(1).toLowerCase();\n    }).join(' ');\n  }\n\n  if (veioDoCookie) return capitalizar(raw);\n\n  var partes = raw.split(/\\s+/);\n  if (partes.length < 2) return null;\n  return capitalizar(partes.slice(1).join(' '));\n}"
        }
